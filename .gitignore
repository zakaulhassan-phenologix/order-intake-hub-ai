# .gitignore

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
.uv/

# Logs
logs/
*.log

# Loguru rotated/compressed logs
*.log.zip

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/

# Docker volumes data (if ever bind-mounted locally)
docker/**/data/

# LangGraph / checkpoint local artifacts (if any local fallback files used in dev)
*.checkpoint

# MCP server local artifacts
mcp_server/**/__pycache__/

# Node (frontend, if monorepo touches it locally)
node_modules/

# Alembic (if used later for migrations) - keep versions, ignore local db
*.sqlite3
*.db

# Secrets / credentials (extra safety net beyond .env)
*.pem
*.key
credentials.json
service-account*.json

test_harness/
tests/